# ============================================================
# ChatApp Docker Environment Variables
# Safe defaults for local development — tracked in git.
# Override locally or use Docker secrets for production.
# ============================================================

# --- General ---
NODE_ENV=development
ENVIRONMENT=development

# --- Backend ---
PORT=3001
BACKEND_PORT=3001

# --- Frontend ---
FRONTEND_PORT=3000
VITE_API_URL=http://localhost/api
VITE_WEBSOCKET_URL=http://localhost

# --- PostgreSQL ---
POSTGRES_USER=chatapp
POSTGRES_PASSWORD=chatapp_secret
POSTGRES_DB=chatapp
POSTGRES_PORT=5432
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USERNAME=chatapp
DATABASE_PASSWORD=chatapp_secret
DATABASE_NAME=chatapp

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- RabbitMQ ---
RABBITMQ_USER=chatapp
RABBITMQ_PASSWORD=chatapp_secret
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672

# --- MinIO ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
S3_BUCKET=chatapp-uploads
SPACES_KEY=minioadmin
SPACES_SECRET_KEY=minioadmin

# --- Auth ---
COOKIE_SECRET=change-this-to-a-random-secret
JWT_SECRET=change-this-to-a-random-jwt-secret
JWT_REFRESH_SECRET=change-this-to-a-random-refresh-secret

# --- CORS ---
CORS_ORIGIN=http://localhost,http://localhost:3000

# --- Superuser ---
SUPERUSER_USERNAME=admin
SUPERUSER_PASSWORD=changeme123!
SUPERUSER_EMAIL=admin@chatapp.local

# --- NGINX ---
NGINX_HTTP_PORT=80

# --- Ollama ---
OLLAMA_HOST=http://ollama:11434
OLLAMA_PORT=11434

# --- Monitoring ---
PROMETHEUS_PORT=9090
GRAFANA_PORT=3002
LOKI_PORT=3100
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
