# ============================================================
# ChatApp Docker Environment Variables
# Safe defaults for local development — tracked in git.
# Real credentials go in .env, .env.production (gitignored).
# ============================================================

# --- General ---
NODE_ENV=development
ENVIRONMENT=development

# --- Backend ---
PORT=3001
BACKEND_PORT=3001

# --- Frontend ---
FRONTEND_PORT=3000
VITE_API_URL=http://localhost/api
VITE_WEBSOCKET_URL=http://localhost

# --- PostgreSQL (Aiven cloud) ---
POSTGRES_USER=avnadmin
POSTGRES_PASSWORD=your-aiven-password
POSTGRES_DB=defaultdb
POSTGRES_PORT=25202
DATABASE_HOST=your-aiven-host.aivencloud.com
DATABASE_PORT=25202
DATABASE_USERNAME=avnadmin
DATABASE_PASSWORD=your-aiven-password
DATABASE_NAME=defaultdb
DATABASE_SSL=true
DATABASE_URL=postgres://avnadmin:your-aiven-password@your-aiven-host.aivencloud.com:25202/defaultdb?sslmode=require

# --- Redis ---
# Docker uses the local redis container. To use Upstash instead, set:
# UPSTASH_REDIS_REST_URL=https://your-upstash-host.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-upstash-token
REDIS_HOST=redis
REDIS_PORT=6379

# --- RabbitMQ ---
RABBITMQ_USER=chatapp
RABBITMQ_PASSWORD=chatapp_secret
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672

# CloudAMQP (Production RabbitMQ - use for deployment)
CLOUDAMQP_URL=amqps://your-cloudamqp-url

# --- Storage (UploadThing) ---
UPLOADTHING_TOKEN=your-uploadthing-token
UPLOADTHING_APP_ID=your-uploadthing-app-id
UPLOADTHING_SECRET=your-uploadthing-secret
S3_BUCKET=chatapp-uploads

# --- Rate Limiting ---
THROTTLE_TTL=1
THROTTLE_LIMIT=10000
AUTH_THROTTLE_LIMIT=1000
AUTH_THROTTLE_TTL=1
FRIEND_THROTTLE_LIMIT=1000
FRIEND_THROTTLE_TTL=1
MSG_THROTTLE_LIMIT=1000
MSG_THROTTLE_TTL=1

# --- Auth ---
COOKIE_SECRET=change-this-to-a-random-secret
JWT_SECRET=change-this-to-a-random-jwt-secret
JWT_REFRESH_SECRET=change-this-to-a-random-refresh-secret

# --- CORS ---
CORS_ORIGIN=http://localhost,http://localhost:3000

# --- Superuser ---
SUPERUSER_USERNAME=admin
SUPERUSER_PASSWORD=changeme123!
SUPERUSER_EMAIL=admin@chatapp.local

# --- NGINX ---
NGINX_HTTP_PORT=80

# --- Ollama ---
OLLAMA_HOST=http://ollama:11434
OLLAMA_PORT=11434

# --- Monitoring ---
PROMETHEUS_PORT=9090
GRAFANA_PORT=3002
LOKI_PORT=3100
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
