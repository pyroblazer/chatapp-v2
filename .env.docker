# ============================================================
# ChatApp Docker Environment Variables
# Safe defaults for local development — tracked in git.
# Override locally or use Docker secrets for production.
# ============================================================

# --- General ---
NODE_ENV=development
ENVIRONMENT=development

# --- Backend ---
PORT=3001
BACKEND_PORT=3001

# --- Frontend ---
FRONTEND_PORT=3000
VITE_API_URL=http://localhost/api
VITE_WEBSOCKET_URL=http://localhost

# --- PostgreSQL ---
POSTGRES_USER=chatapp
POSTGRES_PASSWORD=chatapp_secret
POSTGRES_DB=chatapp
POSTGRES_PORT=5432
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USERNAME=chatapp
DATABASE_PASSWORD=chatapp_secret
DATABASE_NAME=chatapp

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- RabbitMQ ---
RABBITMQ_USER=chatapp
RABBITMQ_PASSWORD=chatapp_secret
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672

# --- Storage (UploadThing + local fallback) ---
# Set UPLOADTHING_TOKEN and UPLOADTHING_APP_ID with real values for cloud storage.
# When blank, the backend falls back to local filesystem storage automatically.
UPLOADTHING_TOKEN=
UPLOADTHING_APP_ID=
S3_BUCKET=chatapp-uploads

# --- Rate Limiting ---
THROTTLE_TTL=10
THROTTLE_LIMIT=100
AUTH_THROTTLE_LIMIT=5
AUTH_THROTTLE_TTL=60

# --- Auth ---
COOKIE_SECRET=change-this-to-a-random-secret
JWT_SECRET=change-this-to-a-random-jwt-secret
JWT_REFRESH_SECRET=change-this-to-a-random-refresh-secret

# --- CORS ---
CORS_ORIGIN=http://localhost,http://localhost:3000

# --- Superuser ---
SUPERUSER_USERNAME=admin
SUPERUSER_PASSWORD=changeme123!
SUPERUSER_EMAIL=admin@chatapp.local

# --- NGINX ---
NGINX_HTTP_PORT=80

# --- Ollama ---
OLLAMA_HOST=http://ollama:11434
OLLAMA_PORT=11434

# --- Monitoring ---
PROMETHEUS_PORT=9090
GRAFANA_PORT=3002
LOKI_PORT=3100
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
