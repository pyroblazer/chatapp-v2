# ChatApp Backend — copy this to .env and fill in your credentials
# All cloud service endpoints are pre-filled; only secrets need replacing.

# Server
PORT=3001
ENVIRONMENT=development

# ── Database (Aiven PostgreSQL) ───────────────────────────────────────────────
DATABASE_HOST=your-aiven-host.aivencloud.com
DATABASE_PORT=25202
DATABASE_USERNAME=avnadmin
DATABASE_PASSWORD=your-aiven-password
DATABASE_NAME=defaultdb
DATABASE_SSL=true
DATABASE_URL=postgres://avnadmin:your-aiven-password@your-aiven-host.aivencloud.com:25202/defaultdb?sslmode=require
# Docker local override: DATABASE_HOST=postgres  DATABASE_PORT=5432  DATABASE_SSL=false

# ── Redis (ioredis rediss:// URL) ────────────────────────────────────────────
REDIS_URL=rediss://default:your-upstash-token@your-upstash-host.upstash.io:6379
# Local Docker fallback (comment REDIS_URL and uncomment below):
# REDIS_HOST=redis
# REDIS_PORT=6379
# REDIS_PASSWORD=

# ── RabbitMQ (CloudAMQP) ──────────────────────────────────────────────────────
RABBITMQ_HOST=armadillo.rmq.cloudamqp.com
RABBITMQ_PORT=5672
RABBITMQ_USER=your-cloudamqp-user
RABBITMQ_PASSWORD=your-cloudamqp-password
RABBITMQ_VHOST=your-cloudamqp-vhost
CLOUDAMQP_URL=amqps://your-cloudamqp-url
# Docker local override: RABBITMQ_HOST=rabbitmq  RABBITMQ_USER=chatapp  RABBITMQ_PASSWORD=chatapp_secret  RABBITMQ_VHOST=/

# ── Storage (UploadThing) ─────────────────────────────────────────────────────
S3_BUCKET=chatapp-uploads
UPLOADTHING_TOKEN=your-uploadthing-token
UPLOADTHING_APP_ID=your-uploadthing-app-id
UPLOADTHING_SECRET=your-uploadthing-secret

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-random-jwt-secret
JWT_REFRESH_SECRET=change-this-to-a-random-refresh-secret
COOKIE_SECRET=change-this-to-a-random-cookie-secret

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000,https://chatapp-v2.vercel.app

# ── Superuser ─────────────────────────────────────────────────────────────────
SUPERUSER_USERNAME=admin
SUPERUSER_PASSWORD=changeme123!
SUPERUSER_EMAIL=your-email@example.com

# ── Firebase (Admin SDK) ──────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-private-key\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com

# ── Rate Limiting ─────────────────────────────────────────────────────────────
THROTTLE_TTL=1
THROTTLE_LIMIT=10000
AUTH_THROTTLE_LIMIT=1000
AUTH_THROTTLE_TTL=1
FRIEND_THROTTLE_LIMIT=1000
FRIEND_THROTTLE_TTL=1
MSG_THROTTLE_LIMIT=1000
MSG_THROTTLE_TTL=1

# ── Ollama / AI Bot (optional) ────────────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434
OLLAMA_PORT=11434
# Docker: OLLAMA_HOST=http://ollama:11434

# ── Kafka (optional) ──────────────────────────────────────────────────────────
KAFKA_BROKER_LIST=your-kafka-host.aivencloud.com:25204
KAFKA_SECURITY_PROTOCOL=ssl
KAFKA_CLIENT_ID=chatapp-backend
KAFKA_GROUP_ID=chatapp-consumer-group

# ── WebRTC / TURN ───────────────────────────────────────────────────────────────
TURN_SERVER_URL=turn:free.expressturn.com:3478
TURN_USERNAME=000000002094437945
TURN_CREDENTIAL=kXzUEtrPK7lkqvYvG90kT3R6L5s=
