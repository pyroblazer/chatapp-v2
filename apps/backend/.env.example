# Server
PORT=3001
ENVIRONMENT=development

# Database (required - PostgreSQL)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=chatapp
DATABASE_PASSWORD=chatapp_secret
DATABASE_NAME=chatapp

# Auth
COOKIE_SECRET=your-cookie-secret

# UploadThing (primary file storage - free tier: 2GB)
UPLOADTHING_TOKEN=your-uploadthing-token
UPLOADTHING_APP_ID=your-uploadthing-app-id

# Local File Storage (fallback when UploadThing is unreachable)
LOCAL_STORAGE_DIR=./uploads
LOCAL_STORAGE_BASE_URL=/api/storage/local
STORAGE_HEALTH_CHECK_INTERVAL=30000

# Redis (optional - degrades to in-memory fallback)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# RabbitMQ (optional - messages dropped when unavailable)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# Ollama / AI Bot (optional - returns friendly message when unavailable)
OLLAMA_HOST=http://localhost:11434
